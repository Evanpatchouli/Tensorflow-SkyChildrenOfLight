{
  "name": "sky-pre",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "serve": "vite",
    "lint": "eslint src vite.config.ts --max-warnings=0",
    "typecheck": "vue-tsc --noEmit",
    "data:generate": "node scripts/generate-prediction.mjs",
    "data:check": "node scripts/generate-prediction.mjs --check",
    "data:test": "node --test scripts/generate-prediction.test.mjs",
    "prebuild": "npm run data:generate",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "smoke:static": "node scripts/smoke-static.mjs"
  },
  "dependencies": {
    "@tensorflow/tfjs": "4.1.0",
    "@tensorflow/tfjs-vis": "1.5.1",
    "element-plus": "^2.14.8",
    "vue": "^3.5.46",
    "vue-router": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "playwright": "^1.65.1",
    "sass": "^1.108.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  }
}
